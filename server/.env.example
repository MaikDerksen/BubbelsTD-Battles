# Einstellungen des Spiel-Servers (alle optional). Ohne Docker z. B. per systemd
# „EnvironmentFile=“ setzen – siehe deploy/scherenschlacht.service.

# Port & Adresse. Hinter einem Reverse-Proxy: HOST=127.0.0.1
PORT=8080
HOST=127.0.0.1
# Datenbank (SQLite-Datei, wird angelegt)
DB_PATH=/var/lib/scherenschlacht/scherenschlacht.db
# Hinter Caddy/nginx: 1 (dann zählen X-Forwarded-For und X-Forwarded-Proto)
TRUST_PROXY=1
# Öffentliche Adresse – nur von hier sind API-Schreibzugriffe & WebSockets erlaubt
PUBLIC_ORIGIN=https://spiel.example.com
SERVER_NAME=Scherenschlacht-Server
ALLOW_REGISTRATION=1
# Grenzen
MAX_MATCHES=150
MAX_CLIENTS=2000
MAX_CONN_PER_IP=6
# Simulation: Ticks Vorlauf für Befehle (15 = 250 ms), Wiederverbinden, Vorrunde
DELAY_TICKS=15
RECONNECT_GRACE_MS=30000
PRE_MATCH_MS=30000
