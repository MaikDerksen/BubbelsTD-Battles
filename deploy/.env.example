# Deine Domain (ohne https://), muss per DNS auf diesen Server zeigen
DOMAIN=spiel.example.com
# Name, der im Spiel angezeigt wird
SERVER_NAME=Scherenschlacht-Server
# 0 = keine neuen Konten mehr (nur noch Gäste & bestehende Konten)
ALLOW_REGISTRATION=1
# Höchstzahl gleichzeitiger Partien (je nach CPU)
MAX_MATCHES=150
